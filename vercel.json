{
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    { "src": "/diagnostic", "dest": "/index.html" },
    { "src": "/vente",      "dest": "/vente.html" },
    { "src": "/reactif",    "dest": "/fiche-reactif.html" },
    { "src": "/anxieux",    "dest": "/fiche-anxieux.html" },
    { "src": "/frustre",    "dest": "/fiche-frustre.html" },
    { "src": "/",           "dest": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options",        "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
